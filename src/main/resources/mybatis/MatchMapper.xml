<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="Match">
    <!-- 경기 등록 -->
    <insert id="matchSave" parameterType="com.letskuf.dto.MatchDTO" useGeneratedKeys="true" keyProperty="matchId">
        insert into match_game(
            league_id
           ,venue_id
           ,home_team_id
           ,away_team_id
           ,match_date
           ,kickoff_time
           ,home_score
           ,away_score
           ,status
        ) values (
            #{leagueId}
           ,#{venueId}
           ,#{homeTeamId}
           ,#{awayTeamId}
           ,#{matchDate}
           ,#{kickoffTime}
           ,#{homeScore}
           ,#{awayScore}
           ,#{status}
        )
    </insert>

    <!-- 경기 수정 -->
    <update id="matchUpdate" parameterType="com.letskuf.dto.MatchDTO">
        update match_game
           set league_id = #{leagueId},
               venue_id = #{venueId},
               home_team_id = #{homeTeamId},
               away_team_id = #{awayTeamId},
               match_date = #{matchDate},
               kickoff_time = #{kickoffTime},
               home_score = #{homeScore},
               away_score = #{awayScore},
               status = #{status}
         where match_id = #{matchId}
    </update>

    <!-- 경기 삭제 -->
    <delete id="matchDelete" parameterType="int">
        delete
          from match_game
         where match_id = #{matchId}
    </delete>

    <!-- 경기 유니폼 등록 -->
    <insert id="matchUniformSave" parameterType="com.letskuf.dto.MatchUniformDTO" useGeneratedKeys="true" keyProperty="matchUniformId">
        insert into match_uniform(
            match_id
           ,team_id
           ,top_color
           ,bottom_color
           ,socks_color
        ) values (
            #{matchId}
           ,#{teamId}
           ,#{topColor}
           ,#{bottomColor}
           ,#{socksColor}
        )
    </insert>

    <!-- 경기 유니폼 수정 -->
    <update id="matchUniformUpdate" parameterType="com.letskuf.dto.MatchUniformDTO">
        update match_uniform
           set match_id = #{matchId},
               team_id = #{teamId},
               top_color = #{topColor},
               bottom_color = #{bottomColor},
               socks_color = #{socksColor}
         where match_uniform_id = #{matchUniformId}
    </update>

    <!-- 경기 유니폼 삭제 -->
    <delete id="matchUniformDelete" parameterType="int">
        delete
          from match_uniform
         where match_uniform_id = #{matchUniformId}
    </delete>

    <!-- 경기 전체 건수 조회 -->
    <select id="matchListCnt" resultType="java.lang.Integer">
        select COUNT(*)
          from match_game
    </select>

    <!-- resultMap 정의 -->
    <resultMap id="matchListMap" type="com.letskuf.dto.MatchDTO">
        <result property="matchId" column="match_id" />
        <result property="matchDate" column="match_date" />
        <result property="kickoffTime" column="kickoff_time" />
        <result property="status" column="status" />
        <result property="leagueNm" column="leagueNm" />
        <result property="venueNm" column="venueNm" />
        <result property="homeTeamNm" column="homeTeamNm" />
        <result property="awayTeamNm" column="awayTeamNm" />
    </resultMap>

    <!-- 경기 전체 조회 -->
    <select id="matchList" parameterType="com.letskuf.dto.MatchDTO" resultMap="matchListMap">
        select mg.match_id
              ,mg.match_date
              ,mg.kickoff_time
              ,mg.status
              ,lt.name AS leagueNm
              ,v.name AS venueNm
              ,ht.team_nm AS homeTeamNm
              ,at.team_nm AS awayTeamNm
          from match_game mg
          left join league_tournament lt
                 on mg.league_id = lt.league_id
          left join venue v
                 on mg.venue_id = v.venue_id
           left join team ht
                  on mg.home_team_id = ht.team_id
           left join team at
                  on mg.away_team_id = at.team_id
          order by match_id asc
          limit #{recordCountPerPage} offset #{firstIndex}
    </select>

    <!-- resultMap 정의 -->
    <resultMap id="matchDetailMap" type="com.letskuf.dto.MatchDTO">
        <result property="leagueId" column="league_id" />
        <result property="matchId" column="match_id" />
        <result property="matchDate" column="match_date" />
        <result property="kickoffTime" column="kickoff_time" />
        <result property="status" column="status" />
        <result property="type" column="type" />
        <result property="leagueNm" column="leagueNm" />
        <result property="venueId" column="venue_id" />
        <result property="venueNm" column="venueNm" />
        <result property="homeTeamId" column="homeTeamId" />
        <result property="homeTeamNm" column="homeTeamNm" />
        <result property="awayTeamId" column="awayTeamId" />
        <result property="awayTeamNm" column="awayTeamNm" />
    </resultMap>

    <!-- 경기 상세 조회 -->
    <select id="matchByMatchId" parameterType="com.letskuf.dto.MatchDTO" resultMap="matchDetailMap">
        select mg.league_id
              ,mg.match_id
              ,mg.match_date
              ,mg.kickoff_time
              ,mg.status
              ,lt.name AS leagueNm
              ,lt.type
              ,v.venue_id
              ,v.name AS venueNm
              ,ht.team_id AS homeTeamId
              ,ht.team_nm AS homeTeamNm
              ,at.team_id AS awayTeamId
              ,at.team_nm AS awayTeamNm
          from match_game mg
          left join league_tournament lt
                 on mg.league_id = lt.league_id
          left join venue v
                 on mg.venue_id = v.venue_id
          left join team ht
                 on mg.home_team_id = ht.team_id
          left join team at
                 on mg.away_team_id = at.team_id
          where match_id = #{matchId}
    </select>

    <!-- resultMap 정의 -->
    <resultMap id="matchUniformDetailMap" type="com.letskuf.dto.MatchUniformDTO">
        <result property="matchUniformId" column="match_uniform_id" />
        <result property="matchId" column="match_id" />
        <result property="teamId" column="team_id" />
        <result property="topColor" column="top_color" />
        <result property="bottomColor" column="bottom_color" />
        <result property="socksColor" column="socks_color" />
    </resultMap>

    <!-- 경기 유니폼 상세 조회 -->
    <select id="matchUniformByMatchId" parameterType="com.letskuf.dto.MatchUniformDTO" resultMap="matchUniformDetailMap">
        select match_uniform_id
              ,match_id
              ,team_id
              ,top_color
              ,bottom_color
              ,socks_color
          from match_uniform
         where match_id = #{matchId}
    </select>

    <!-- 라인업 등록 상태 확인-->
    <select id="isLineupCompleted" parameterType="int" resultType="boolean">
    SELECT COUNT(*) = 2
      FROM (
            SELECT team_id
              FROM match_lineup
             WHERE match_id = #{matchId}
             GROUP BY team_id
             HAVING COUNT(*) >= 11
            ) t
    </select>

    <!-- 경기 상태 변경 -->
    <update id="updateMatchStatus" parameterType="com.letskuf.dto.MatchDTO">
        update match_game
           set status = #{status}
         where match_id = #{matchId}
    </update>

    <!-- resultMap 정의 -->
    <resultMap id="matchResultListMap" type="com.letskuf.dto.MatchDTO">
        <result property="matchId" column="match_id" />
        <result property="matchDate" column="match_date" />
        <result property="kickoffTime" column="kickoff_time" />
        <result property="status" column="status" />
        <result property="leagueNm" column="leagueNm" />
        <result property="venueNm" column="venueNm" />
        <result property="homeTeamNm" column="homeTeamNm" />
        <result property="awayTeamNm" column="awayTeamNm" />
        <result property="homeScore" column="homeScore" />
        <result property="awayScore" column="awayScore" />
    </resultMap>

    <!-- 경기 결과 조회 -->
    <select id="selectMatchResultList" parameterType="com.letskuf.dto.MatchSearchDTO" resultMap="matchResultListMap">
        SELECT mg.match_id,
               mg.match_date,
               mg.kickoff_time,
               mg.status,
               lt.name AS leagueNm,
               v.name AS venueNm,
               ht.team_nm AS homeTeamNm,
               at.team_nm AS awayTeamNm,
               COALESCE(hs.goal_count,0) AS homeScore,
               COALESCE(ascore.goal_count,0) AS awayScore
          FROM match_game mg
          JOIN league_tournament lt
            ON mg.league_id = lt.league_id
          JOIN venue v
            ON mg.venue_id = v.venue_id
          JOIN team ht
            ON mg.home_team_id = ht.team_id
          JOIN team at
            ON mg.away_team_id = at.team_id
        LEFT JOIN (
            SELECT match_id,
                   team_id,
                   COUNT(*) goal_count
              FROM match_event
             WHERE event_type='GOAL'
          GROUP BY match_id, team_id
        ) hs
        ON hs.match_id = mg.match_id
        AND hs.team_id = mg.home_team_id
        LEFT JOIN (
            SELECT match_id,
                   team_id,
                   COUNT(*) goal_count
              FROM match_event
             WHERE event_type='GOAL'
          GROUP BY match_id, team_id
        ) ascore
        ON ascore.match_id = mg.match_id
        AND ascore.team_id = mg.away_team_id
        <where>
            <if test="type != null">
                AND lt.type = #{type}
            </if>
            <if test="leagueId != null and leagueId != ''">
                AND mg.league_id = #{leagueId}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (
                    ht.team_nm LIKE CONCAT('%',#{keyword},'%')
                OR
                    at.team_nm LIKE CONCAT('%',#{keyword},'%')
                )
            </if>
            <if test="status != null and status != ''">
                AND mg.status = #{status}
            </if>
            <if test="startDate != null">
                AND mg.match_date <![CDATA[>=]]> #{startDate}
            </if>
            <if test="endDate != null">
                AND mg.match_date <![CDATA[<=]]> #{endDate}
            </if>
        </where>
        ORDER BY mg.match_date DESC,
                 mg.kickoff_time ASC
        LIMIT #{recordCountPerPage} OFFSET #{firstIndex}
    </select>

    <!-- 경기 결과 갯수 -->
    <select id="selectMatchResultCount" parameterType="com.letskuf.dto.MatchSearchDTO" resultType="int">
        SELECT COUNT(*)
          FROM match_game mg
          JOIN league_tournament lt
            ON mg.league_id = lt.league_id
          JOIN team ht
            ON mg.home_team_id=ht.team_id
          JOIN team at
            ON mg.away_team_id=at.team_id
        <where>
            <if test="type != null">
                AND lt.type = #{type}
            </if>
            <if test="leagueId != null and leagueId != ''">
                AND mg.league_id = #{leagueId}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (
                ht.team_nm LIKE CONCAT('%',#{keyword},'%')
                OR
                at.team_nm LIKE CONCAT('%',#{keyword},'%')
                )
            </if>
            <if test="status != null and status != ''">
                AND mg.status = #{status}
            </if>
            <if test="startDate != null">
                AND mg.match_date <![CDATA[>=]]> #{startDate}
            </if>
            <if test="endDate != null">
                AND mg.match_date <![CDATA[<=]]> #{endDate}
            </if>
        </where>
    </select>
</mapper>